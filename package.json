  },
  "scripts": {
    "test": "node --test tests/page.test.cjs tests/statistics.test.cjs && node tests/traffic-migration.cjs && node tests/api.cjs && node tests/cards-browser.cjs && node tests/watchdog-browser.cjs && node tests/browser.cjs && node tests/management-browser.cjs && node tests/initialization-browser.cjs",
    "dev:api": "wrangler dev --config wrangler.local.jsonc --port 8787",
