{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "livingstones-api",
  "main": "backend/worker.js",
  "compatibility_date": "2026-10-05",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "WATCHDOG_FROM": "watchdog@rodulab.com",
    "WATCHDOG_SITE_URL": "https://livingstones.rodulab.com",
    "WATCHDOG_API_URL": "https://livingstones-api.livingstones-romanduris.workers.dev",
    "ALLOWED_ORIGINS": "https://romanduris.github.io,https://livingstones.rodulab.com",
  },
  "triggers": { "crons": ["*/10 * * * *"] },
  "send_email": [{ "name": "EMAIL" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "livingstones-db",
      "database_id": "abc06c1b-e845-434a-b105-0b17b7f82908",
      "migrations_dir": "backend/migrations",
    },
  ],
}
